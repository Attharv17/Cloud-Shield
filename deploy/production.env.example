CLOUDSHIELD_ENV=production
CLOUDSHIELD_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CLOUDSHIELD_COOKIE_SECURE=true
CLOUDSHIELD_DATABASE=/var/lib/cloudshield/cloudshield.sqlite3
CLOUDSHIELD_TRUST_PROXY=true
CLOUDSHIELD_PORT=8000
# Optional rule and risk policy files must be shared by web and worker.
# CLOUDSHIELD_RULES_FILE=/etc/cloudshield/rules.json
# CLOUDSHIELD_RISK_POLICY_FILE=/etc/cloudshield/risk-policy.json
