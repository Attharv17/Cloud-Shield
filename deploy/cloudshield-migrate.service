[Unit]
Description=Apply CloudShield database migrations
Before=cloudshield-web.service cloudshield-worker.service

[Service]
Type=oneshot
RemainAfterExit=true
User=cloudshield
Group=cloudshield
WorkingDirectory=/opt/cloudshield
EnvironmentFile=/etc/cloudshield.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cloudshield/.venv/bin/python -m flask --app app init-db
StateDirectory=cloudshield
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloudshield
