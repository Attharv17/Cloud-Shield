[Unit]
Description=Create a verified CloudShield database backup
After=cloudshield-migrate.service
Requires=cloudshield-migrate.service

[Service]
Type=oneshot
User=cloudshield
Group=cloudshield
WorkingDirectory=/opt/cloudshield
EnvironmentFile=/etc/cloudshield.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/cloudshield/.venv/bin/python -m flask --app app backup-db --directory /var/lib/cloudshield-backups
StateDirectory=cloudshield-backups
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/cloudshield /var/lib/cloudshield-backups
