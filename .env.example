# Generate a random value: python -c "import secrets; print(secrets.token_hex(32))"
CLOUDSHIELD_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
CLOUDSHIELD_ENV=development
# Set true only when serving over HTTPS.
CLOUDSHIELD_COOKIE_SECURE=false
# Optional absolute SQLite file path; defaults to instance/cloudshield.sqlite3.
# CLOUDSHIELD_DATABASE=C:/Work/Cloud-Shield/instance/cloudshield.sqlite3
